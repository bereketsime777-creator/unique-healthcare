# Server port (Render sets PORT automatically)
PORT=5000

# MongoDB Atlas connection string (standard mongodb:// format recommended)
MONGODB_URI=mongodb://username:password@host1:27017,host2:27017,host3:27017/?ssl=true&replicaSet=your-replica-set&authSource=admin

# JWT secret for auth tokens (use a long random string)
JWT_SECRET=your_jwt_secret_here

# Frontend URL for CORS, password reset links, and payment redirects
FRONTEND_URL=http://localhost:5173

# Optional: backend URL for payment callbacks (defaults to localhost in dev)
BACKEND_URL=http://localhost:5000

# Cloudinary (product image uploads)
CLOUDINARY_NAME=your_cloud_name
CLOUDINARY_KEY=your_api_key
CLOUDINARY_SECRET=your_api_secret

# Chapa payment gateway
CHAPA_SECRET_KEY=your_chapa_secret_key

# Gmail / SMTP for order emails and password reset (optional in dev)
EMAIL_USER=your_email@gmail.com
EMAIL_PASS=your_app_password
